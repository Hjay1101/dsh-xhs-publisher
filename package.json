{
  "name": "dsh-xhs-publisher",
  "version": "0.1.1",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "description": "DeepSeek Harness plugin: Xiaohongshu (RED) publishing assistant — title/body length checks, live counters, canvas cover generator and one-click copy",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "xiaohongshu",
    "xhs",
    "rednote",
    "publisher",
    "cover"
  ],
  "type": "module",
  "main": "./index.js",
  "files": [
    "index.js",
    "client.js",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1"
  }
}